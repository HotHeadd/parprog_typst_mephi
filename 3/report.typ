== Блок-схема
#figure(
  diagram(
    ..diagram-defaults,

    n_io(<s>, 0, -1, [ShellSort(arr, size)]),
    n_for_custom(<sf>, 0, 0, [s = size/2;\ s > 0;\ s /= 2]),
    n_for_up(<of>, 0, 1, "offset", 0, [\< s]),
    n_for_custom(<ifor>, 0, 2, [i = offset + s;\ i < size;\ i += s]),
    n_for_custom(<jfor>, 0, 3, [j = i - s;\ j >= 0 &&\ arr[j] > arr[j+s];\ j -= s], s: 10pt),
    n_common(<pr>, 0, 4, [tmp = arr[j]\ arr[j] = arr[j+s]\ arr[j+s] = tmp], s: 12pt),
    n_io(<e>, -1, 1, [return 0]),

    edge(<s>, <sf>),
    edge(<sf>, <of>),
    edge(<of>, <ifor>),
    edge(<ifor>, <jfor>),
